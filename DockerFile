# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution and project files
COPY RealEstateApp.slnx .
COPY src/RealEstateApp.Domain/RealEstateApp.Domain.csproj src/RealEstateApp.Domain/
COPY src/RealEstateApp.Application/RealEstateApp.Application.csproj src/RealEstateApp.Application/
COPY src/RealEstateApp.Infrastructure/RealEstateApp.Infrastructure.csproj src/RealEstateApp.Infrastructure/
COPY src/RealEstateApp.API/RealEstateApp.API.csproj src/RealEstateApp.API/

# Restore packages — point explicitly to the solution file
RUN dotnet restore RealEstateApp.slnx

# Copy all source code
COPY src/ src/

# Build and publish
RUN dotnet publish src/RealEstateApp.API/RealEstateApp.API.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

ENTRYPOINT ["dotnet", "RealEstateApp.API.dll"]