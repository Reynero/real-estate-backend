# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution and project files
COPY *.sln .
COPY src/RealEstateApp.Domain/RealEstateApp.Domain.csproj src/RealEstateApp.Domain/
COPY src/RealEstateApp.Application/RealEstateApp.Application.csproj src/RealEstateApp.Application/
COPY src/RealEstateApp.Infrastructure/RealEstateApp.Infrastructure.csproj src/RealEstateApp.Infrastructure/
COPY src/RealEstateApp.API/RealEstateApp.API.csproj src/RealEstateApp.API/

# Restore packages
RUN dotnet restore

# Copy all source code
COPY src/ src/

# Build and publish
RUN dotnet publish src/RealEstateApp.API/RealEstateApp.API.csproj -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

ENTRYPOINT ["dotnet", "RealEstateApp.API.dll"]